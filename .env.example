# ---------------------------------------------------------------------------
# Probatio — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env
# ---------------------------------------------------------------------------

# --- API keys (sources gratuites nécessitant une clé) -----------------------
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=

# --- SEC EDGAR : pas de clé, mais un User-Agent identifiable est exigé par
# les conditions d'usage de la SEC (nom de projet + email de contact)
SEC_EDGAR_USER_AGENT=Probatio research contact@example.com

# --- Chemins de l'entrepôt de données ----------------------------------------
DATA_RAW_DIR=./data/raw
DATA_WAREHOUSE_DIR=./data/warehouse
APP_DB_PATH=./data/app.db

# --- FastAPI ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Next.js (côté frontend, préfixe NEXT_PUBLIC_ requis pour exposition client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Scheduler (APScheduler) --------------------------------------------------
# Fréquence de rafraîchissement des données daily (cron-like, ex: "0 22 * * 1-5")
INGEST_DAILY_CRON=0 22 * * 1-5
# Fréquence de rafraîchissement crypto (ex: toutes les heures)
INGEST_CRYPTO_CRON=0 * * * *

# --- Divers ---------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
