# URL de l'API FastAPI (apps/api). Copier ce fichier en `.env.local` (jamais
# commité, comme .env.example à la racine du repo) et ajuster si besoin.
# Nom de variable aligné sur .env.example (racine) et docker-compose.yml —
# NEXT_PUBLIC_API_BASE_URL, pas NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
